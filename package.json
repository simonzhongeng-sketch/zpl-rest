    "cors": "^2.8.5",
    "diskdb": "^0.1.17",
    "ejs": "^3.1.10",
    "express": "^4.22.1",
    "express-session": "^1.17.0",
    "mustache": "^3.1.0",
    "serve-favicon": "^2.5.0",
    "systray2": "^2.1.4",
    "websocket": "^1.0.30",
    "xlsx": "^0.18.5",
    "zod": "^4.6.7",
    "zpl-renderer-js": "^5.0.0"
  },
  "devDependencies": {
    "@yao-pkg/pkg": "^6.24.0"
