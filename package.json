{
  "name": "zpl-rest",
  "version": "1.1.0",
  "description": "Webservice for Zebra ZPL printing",
  "main": "main.js",
  "bin": "main.js",
  "scripts": {
    "start": "node main.js",
    "build:win": "node scripts/build_win.js",
    "test": "echo \"Error: no test specified\" && exit 1",
    "build:win:portable": "node scripts/build_win_portable.js"
