    <!-- Sidebar -->
    <ul class="navbar-nav bg-gradient-primary sidebar sidebar-dark accordion toggled" id="accordionSidebar">

      <!-- Sidebar - Brand -->
      <a class="sidebar-brand d-flex align-items-center justify-content-center" href="/">
        <div class="sidebar-brand-icon rotate-n-15">
          <i class="fas fa-laugh-wink"></i>
        </div>
        <div class="sidebar-brand-text mx-3">rest<sup>ZPL</sup></div>
      </a>

      <!-- Divider -->
      <hr class="sidebar-divider my-0">

      <li class="nav-item">
        <a class="nav-link" href="/">
          <i class="fas fa-fw fa-tachometer-alt"></i>
          <span data-i18n="nav.overview">Overview</span></a>
      </li>
      <li class="nav-item">
        <a class="nav-link" href="/queue">
          <i class="fas fa-fw fa-list-ol"></i>
          <span data-i18n="nav.queue">Queue</span></a>
      </li>
      <li class="nav-item">
        <a class="nav-link" href="/label">
          <i class="fas fa-fw fa-tags"></i>
          <span data-i18n="nav.label">Label</span></a>
      </li>
      <li class="nav-item active">
        <a class="nav-link" href="/printer">
          <i class="fas fa-fw fa-print"></i>
          <span data-i18n="nav.printer">Printer</span></a>
      </li>
      <li class="nav-item">
        <a class="nav-link" href="/manual">
          <i class="fas fa-fw fa-book"></i>
          <span data-i18n="nav.manual">Manual</span></a>
      </li>

      <!-- Divider -->
      <hr class="sidebar-divider d-none d-md-block">

      <!-- Sidebar Toggler (Sidebar) -->
      <div class="text-center d-none d-md-inline">
        <button class="rounded-circle border-0" id="sidebarToggle"></button>
      </div>

    </ul>
    <!-- End of Sidebar -->

    <!-- Content Wrapper -->
    <div id="content-wrapper" class="d-flex flex-column">

      <!-- Main Content -->
      <div id="content" style="padding-top: 30px;">

        <!-- Begin Page Content -->
        <div class="container-fluid">

          <!-- Page Heading -->
          <div class="d-sm-flex align-items-center justify-content-between mb-4">
            <h1 class="h3 mb-0 text-gray-800" data-i18n="pr.title">Printer</h1>
          </div>

          <div class="row">
            <div class="col-lg-12">
              <div class="card shadow mb-4">
                <div class="card-header py-3 d-flex justify-content-between align-items-center">
                  <h6 class="m-0 font-weight-bold text-primary" data-i18n="pr.discover">Discover Printers</h6>
                  <div>
                    <button class="btn btn-sm btn-secondary mr-1" id="manual-add-btn" data-i18n="pr.create"><i class="fas fa-plus"></i> Create Printer</button>
                    <button class="btn btn-sm btn-secondary mr-1" id="rediscover-printers" data-i18n="pr.rediscover"><i class="fas fa-map-marker-alt"></i> Refind Printers</button>
                    <button class="btn btn-sm btn-primary" id="scanprinters" data-i18n="pr.scan"><i class="fas fa-search"></i> Auto Scan</button>
                  </div>
                </div>
                <div class="card-body">
                  <p class="text-muted small mb-2" data-i18n="pr.discover_hint">Scans the server's local subnet for Zebra printers automatically. If your printer is not found, use "Create Printer" to add it manually.</p>
                  <div class="form-inline mb-2">
                    <label class="small text-muted mr-2" for="discover-subnet" data-i18n="pr.subnet_label">Subnet</label>
                    <input class="form-control form-control-sm mr-2" id="discover-subnet" style="max-width:230px" placeholder="auto / 192.168.8" data-i18n-placeholder="pr.subnet_ph">
                    <span class="small text-muted" data-i18n="pr.subnet_hint">Leave empty to scan every local network interface.</span>
                  </div>
                  <div class="form-inline mb-2">
                    <label class="small text-muted mr-2" for="probe-address" data-i18n="pr.probe_label">Test</label>
                    <input class="form-control form-control-sm mr-2" id="probe-address" style="max-width:230px" placeholder="192.168.8.43:9100" data-i18n-placeholder="pr.probe_ph">
                    <button class="btn btn-sm btn-outline-primary" id="probe-btn" type="button" data-i18n="pr.probe_btn">Test connection</button>
                    <span id="probe-result" class="small ml-2"></span>
                  </div>
                  <div id="discover-results"></div>
                </div>
              </div>
            </div>
          </div>

          <div class="row">
            <div class="col-lg-12">
              <div class="card shadow mb-4">
                <div class="card-header py-3 d-flex justify-content-between align-items-center">
                  <h6 class="m-0 font-weight-bold text-primary" data-i18n="pr.list">Printers</h6>
                  <button class="btn btn-sm btn-secondary" id="refresh-printers" data-i18n="btn.refresh"><i class="fas fa-sync-alt"></i> Refresh</button>
                </div>
                <div class="card-body">
                  <div class="table-responsive">
                    <table class="table table-bordered table-hover table-sm">
                      <thead>
                        <tr>
                          <th data-i18n="th.status">Status</th>
                          <th data-i18n="th.name">Name</th>
                          <th data-i18n="th.address">Address</th>
                          <th data-i18n="th.model">Model</th>
                          <th data-i18n="th.density">Density</th>
                          <th data-i18n="th.settings">Settings</th>
                          <th style="width: 170px;" data-i18n="th.actions">Actions</th>
                        </tr>
                      </thead>
                      <tbody id="printer-list"></tbody>
                    </table>
                  </div>
                </div>
              </div>
            </div>
          </div>

        </div>
        <!-- /.container-fluid -->

      </div>
      <!-- End of Main Content -->

    </div>
    <!-- End of Content Wrapper -->

  </div>
  <!-- End of Page Wrapper -->

  <!-- Create Printer Modal -->
  <div class="modal fade" id="createPrinterModal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog" role="document">
      <div class="modal-content">
        <div class="modal-header">
          <h5 class="modal-title" data-i18n="pr.create_title">Create Printer</h5>
          <button type="button" class="close" data-dismiss="modal" aria-label="Close">
            <span aria-hidden="true">&times;</span>
          </button>
        </div>
        <div class="modal-body">
          <form id="createprinterform">
            <div class="form-group">
              <label for="newname" data-i18n="th.name">Name</label>
              <input type="text" class="form-control" id="newname" name="newname" data-i18n-placeholder="pr.name_ph" placeholder="Printer Name">
            </div>
            <div class="form-group">
              <label data-i18n="pr.conn">Connection</label>
              <div class="btn-group d-flex" id="newconn-group">
                <button type="button" class="btn conn-btn w-100 active btn-primary" data-conn="tcp"><i class="fas fa-network-wired"></i> <span data-i18n="pr.conn_tcp">TCP / Network</span></button>
                <button type="button" class="btn conn-btn w-100 btn-secondary" data-conn="usb"><i class="fas fa-usb"></i> <span data-i18n="pr.conn_usb">USB / Local Driver</span></button>
              </div>
            </div>
            <div class="form-group" id="new-address-group">
              <label for="newaddress" data-i18n="th.address">Address</label>
              <input type="text" class="form-control" id="newaddress" name="newaddress" data-i18n-placeholder="pr.address_ph" placeholder="Printer Address IP:Port eg. 127.0.0.1:9100">
              <small class="form-text text-muted" data-i18n="pr.address_help">IP alone is fine — port 9100 is assumed.</small>
            </div>
            <div class="form-group" id="new-usb-group" style="display:none;">
              <label for="newusb" data-i18n="pr.usb_pick">Windows Printer (USB driver installed)</label>
              <div class="input-group">
                <select class="form-control" id="newusb"></select>
                <div class="input-group-append">
                  <button class="btn btn-outline-secondary" type="button" id="newusb-refresh"><i class="fas fa-sync-alt"></i></button>
                </div>
              </div>
              <small class="text-muted" data-i18n="pr.usb_hint">ZPL is sent to the Windows spooler (RAW) — install the Zebra driver first</small>
            </div>
            <div class="form-group">
              <label for="newmodel" data-i18n="pr.model">Device Model (optional, auto-matches settings)</label>
              <input type="text" class="form-control" id="newmodel" name="newmodel" data-i18n-placeholder="pr.model_ph" placeholder="eg. ZT510">
            </div>
            <div class="form-group">
              <div class="dropdown">
                <button class="btn btn-secondary dropdown-toggle" role="button" id="newdensity" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false" data-i18n="pr.density">
                  Density / Resolution
                </button>
                <div class="dropdown-menu" aria-labelledby="dropdownMenuLink">
                  <a class="dropdown-item density-item" data-density="6dpmm" href="#">6 dpmm / 152 dpi</a>
                  <a class="dropdown-item density-item" data-density="8dpmm" href="#">8 dpmm / 200 dpi</a>
                  <a class="dropdown-item density-item" data-density="12dpmm" href="#">12 dpmm / 300 dpi</a>
                  <a class="dropdown-item density-item" data-density="24dpmm" href="#">24 dpmm / 600 dpi</a>
                </div>
              </div>
            </div>
            <hr>
            <h6 class="text-muted"><span data-i18n="pr.print_settings">Print Settings</span> <small data-i18n="pr.ps_new">(defaults from model profile, adjustable)</small></h6>
            <div class="form-row">
              <div class="form-group col-4">
                <label for="newmode" data-i18n="pr.mode">Mode</label>
                <select class="form-control" id="newmode">
                  <option value="thermal_transfer" selected data-i18n="mode.tt">Thermal Transfer</option>
                  <option value="direct_thermal" data-i18n="mode.dt">Direct Thermal</option>
                </select>
              </div>
              <div class="form-group col-4">
                <label for="newdarkness" data-i18n="pr.darkness">Darkness (-30 ~ 30)</label>
                <input type="number" class="form-control" id="newdarkness" value="0" min="-30" max="30">
              </div>
              <div class="form-group col-4">
                <label for="newspeed" data-i18n="pr.speed">Speed (ips)</label>
                <input type="number" class="form-control" id="newspeed" value="2" min="1" max="12">
              </div>
            </div>
            <!-- 物理位置参数：默认 1.5 / 0.8（与 main.js 的 DEFAULT_BASE_ORIGIN_MM 一致） -->
            <div class="form-row">
              <div class="form-group col-4">
                <label for="newleft" data-i18n="pr.left_pos">Left position (mm)</label>
                <input type="number" class="form-control" id="newleft" step="0.1" min="-20" max="20" value="1.5">
              </div>
              <div class="form-group col-4">
                <label for="newtop" data-i18n="pr.top_pos">Label top position (mm)</label>
                <input type="number" class="form-control" id="newtop" step="0.1" min="-20" max="20" value="0.8">
              </div>
            </div>
            <small class="form-text text-muted" data-i18n="pr.origin_hint">Base origin for ^LH; default 1.5 / 0.8 (^LH18,10 @12dpmm); set 0 to disable</small>
          </form>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" data-dismiss="modal" data-i18n="btn.cancel">Cancel</button>
          <button type="button" class="btn btn-primary" id="createprinter" data-i18n="btn.create">Create</button>
        </div>
      </div>
    </div>
  </div>

  <!-- Edit Printer Modal -->
  <div class="modal fade" id="editPrinterModal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog" role="document">
      <div class="modal-content">
        <div class="modal-header">
          <h5 class="modal-title" data-i18n="pr.edit_title">Edit Printer</h5>
          <button type="button" class="close" data-dismiss="modal" aria-label="Close">
            <span aria-hidden="true">&times;</span>
          </button>
        </div>
        <div class="modal-body">
          <form>
            <div class="form-group">
              <label for="printerid" data-i18n="pr.printer_id">Printer ID</label>
              <div class="input-group mb-3">
                <input type="text" class="form-control" id="printerid" data-i18n-placeholder="pr.printer_id_ph" placeholder="ID for REST" readonly>
                <div class="input-group-append">
                  <button class="btn btn-primary copy-button" type="button" data-target="printerid"><i class="fas fa-copy"></i></button>
                </div>
              </div>
            </div>
            <div class="form-group">
              <label for="editname" data-i18n="th.name">Name</label>
              <input type="text" class="form-control" id="editname" name="editname" data-i18n-placeholder="pr.name_ph" placeholder="Printer Name">
            </div>
            <div class="form-group">
              <label data-i18n="pr.conn">Connection</label>
              <div class="btn-group d-flex" id="editconn-group">
                <button type="button" class="btn conn-btn w-100 active btn-primary" data-conn="tcp"><i class="fas fa-network-wired"></i> <span data-i18n="pr.conn_tcp">TCP / Network</span></button>
                <button type="button" class="btn conn-btn w-100 btn-secondary" data-conn="usb"><i class="fas fa-usb"></i> <span data-i18n="pr.conn_usb">USB / Local Driver</span></button>
              </div>
            </div>
            <div class="form-group" id="edit-address-group">
              <label for="editaddress" data-i18n="th.address">Address</label>
              <input type="text" class="form-control" id="editaddress" name="editaddress" data-i18n-placeholder="pr.address_ph" placeholder="Printer Address IP:Port eg. 127.0.0.1:9100">
              <small class="form-text text-muted" data-i18n="pr.address_help">IP alone is fine — port 9100 is assumed.</small>
            </div>
            <div class="form-group" id="edit-usb-group" style="display:none;">
              <label for="editusb" data-i18n="pr.usb_pick">Windows Printer (USB driver installed)</label>
              <div class="input-group">
                <select class="form-control" id="editusb"></select>
                <div class="input-group-append">
                  <button class="btn btn-outline-secondary" type="button" id="editusb-refresh"><i class="fas fa-sync-alt"></i></button>
                </div>
              </div>
              <small class="text-muted" data-i18n="pr.usb_hint">ZPL is sent to the Windows spooler (RAW) — install the Zebra driver first</small>
            </div>
            <div class="form-group">
              <div class="dropdown">
                <button class="btn btn-secondary dropdown-toggle" role="button" id="editdensity" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false" data-i18n="pr.density">
                  Density / Resolution
                </button>
                <div class="dropdown-menu" aria-labelledby="dropdownMenuLink">
                  <a class="dropdown-item density-item" data-density="6dpmm" href="#">6 dpmm / 152 dpi</a>
                  <a class="dropdown-item density-item" data-density="8dpmm" href="#">8 dpmm / 200 dpi</a>
                  <a class="dropdown-item density-item" data-density="12dpmm" href="#">12 dpmm / 300 dpi</a>
                  <a class="dropdown-item density-item" data-density="24dpmm" href="#">24 dpmm / 600 dpi</a>
                </div>
              </div>
            </div>
            <hr>
            <h6 class="text-muted"><span data-i18n="pr.print_settings">Print Settings</span> <small data-i18n="pr.ps_edit">(printer-level, applies to all labels printed on it)</small></h6>
            <div class="form-row">
              <div class="form-group col-4">
                <label for="editmode" data-i18n="pr.mode">Mode</label>
                <select class="form-control" id="editmode">
                  <option value="thermal_transfer" data-i18n="mode.tt">Thermal Transfer</option>
                  <option value="direct_thermal" data-i18n="mode.dt">Direct Thermal</option>
                </select>
              </div>
              <div class="form-group col-4">
                <label for="editdarkness" data-i18n="pr.darkness">Darkness (-30 ~ 30)</label>
                <input type="number" class="form-control" id="editdarkness" value="0" min="-30" max="30">
              </div>
              <div class="form-group col-4">
                <label for="editspeed" data-i18n="pr.speed">Speed (ips)</label>
                <input type="number" class="form-control" id="editspeed" value="2" min="1" max="12">
              </div>
            </div>
            <!-- 物理位置参数：写入 ^LH 的基础原点（printer.settings.base_origin_mm），
                 归打印机所有，标签编辑页不再有位置参数。x = 左侧位置，y = 标签顶部位置。 -->
            <div class="form-row">
              <div class="form-group col-4">
                <label for="editleft" data-i18n="pr.left_pos">Left position (mm)</label>
                <input type="number" class="form-control" id="editleft" step="0.1" min="-20" max="20" value="1.5">
              </div>
              <div class="form-group col-4">
                <label for="edittop" data-i18n="pr.top_pos">Label top position (mm)</label>
                <input type="number" class="form-control" id="edittop" step="0.1" min="-20" max="20" value="0.8">
              </div>
            </div>
            <small class="form-text text-muted" data-i18n="pr.origin_hint">Base origin for ^LH; default 1.5 / 0.8 (^LH18,10 @12dpmm); set 0 to disable</small>
          </form>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" data-dismiss="modal" data-i18n="btn.cancel">Cancel</button>
          <button type="button" class="btn btn-primary" id="editprinter" data-i18n="btn.update">Update</button>
        </div>
      </div>
    </div>
  </div>

  <!-- Scroll to Top Button-->
  <a class="scroll-to-top rounded" href="#page-top">
    <i class="fas fa-angle-up"></i>
  </a>

