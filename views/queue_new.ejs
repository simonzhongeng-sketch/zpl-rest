<!DOCTYPE html>
<html lang="en">

<head>
  <!-- early dir/lang bootstrap: apply saved language direction before first paint,
       independent of the later i18n.js (works even if scripts are cached/failed) -->
  <script>
    (function() {
      try {
        var l = new URLSearchParams(location.search).get('lang') || localStorage.getItem('lang') || 'en';
        document.documentElement.setAttribute('lang', l);
        if (l === 'ar') document.documentElement.setAttribute('dir', 'rtl');
      } catch (e) {}
    })();
  </script>

  <meta charset="utf-8">
  <meta http-equiv="X-UA-Compatible" content="IE=edge">
  <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
  <meta name="description" content="">
  <meta name="author" content="">

  <title data-i18n="title.queue_new">restZPL 标签打印</title>

  <!-- Custom fonts for this template-->
  <link href="/vendor/fontawesome-free/css/all.min.css" rel="stylesheet" type="text/css">
  <link href="https://fonts.googleapis.com/css?family=Nunito:200,200i,300,300i,400,400i,600,600i,700,700i,800,800i,900,900i" rel="stylesheet">

  <!-- Custom styles for this template-->
  <link href="/css/sb-admin-2.min.css" rel="stylesheet">
  <link href="/css/custom.css" rel="stylesheet">
  <link href="/vendor/toastr/toastr.min.css" rel="stylesheet">

  <style>
    .task-card { min-width: 260px; max-width: 300px; }
    .task-card .card { height: 100%; }
    .task-card .task-img-box {
      height: 110px;
      display: flex;
      align-items: center;
      justify-content: center;
      background: #f8f9fc;
      border-radius: .25rem;
      overflow: hidden;
      margin-bottom: .5rem;
    }
    .task-card .task-img-box img { max-width: 100%; max-height: 100%; width: auto; height: auto; }
    .task-card .task-summary {
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }
    .var-chip { display: inline-block; margin: 0 4px 4px 0; }
  </style>

</head>

<body id="page-top" class="sidebar-toggled">

  <!-- Page Wrapper -->
  <div id="wrapper">

    <!-- Sidebar -->
    <ul class="navbar-nav bg-gradient-primary sidebar sidebar-dark accordion toggled" id="accordionSidebar">

      <!-- Sidebar - Brand -->
      <a class="sidebar-brand d-flex align-items-center justify-content-center" href="/">
        <div class="sidebar-brand-icon rotate-n-15">
          <i class="fas fa-laugh-wink"></i>
        </div>
        <div class="sidebar-brand-text mx-3">rest<sup>ZPL</sup></div>
      </a>

      <!-- Divider -->
      <hr class="sidebar-divider my-0">

      <li class="nav-item">
        <a class="nav-link" href="/">
          <i class="fas fa-fw fa-tachometer-alt"></i>
          <span data-i18n="nav.overview">Overview</span></a>
      </li>
      <li class="nav-item active">
        <a class="nav-link" href="/queue">
          <i class="fas fa-fw fa-list-ol"></i>
          <span data-i18n="nav.queue">Queue</span></a>
      </li>
      <li class="nav-item">
        <a class="nav-link" href="/label">
          <i class="fas fa-fw fa-tags"></i>
          <span data-i18n="nav.label">Label</span></a>
      </li>
      <li class="nav-item">
        <a class="nav-link" href="/printer">
          <i class="fas fa-fw fa-print"></i>
          <span data-i18n="nav.printer">Printer</span></a>
      </li>
      <li class="nav-item">
        <a class="nav-link" href="/manual">
          <i class="fas fa-fw fa-book"></i>
          <span data-i18n="nav.manual">Manual</span></a>
      </li>

      <!-- Divider -->
      <hr class="sidebar-divider d-none d-md-block">

      <!-- Sidebar Toggler (Sidebar) -->
      <div class="text-center d-none d-md-inline">
        <button class="rounded-circle border-0" id="sidebarToggle"></button>
      </div>

    </ul>
    <!-- End of Sidebar -->

    <!-- Content Wrapper -->
    <div id="content-wrapper" class="d-flex flex-column">

      <!-- Main Content -->
      <div id="content" style="padding-top: 30px;">

        <!-- Begin Page Content -->
        <div class="container-fluid">

          <!-- Page Heading -->
          <div class="d-sm-flex align-items-center justify-content-between mb-4">
            <h1 class="h3 mb-0 text-gray-800" data-i18n="qn.title">New Print Queue</h1>
            <a class="btn btn-sm btn-secondary" href="/queue" data-i18n="qn.back"><i class="fas fa-arrow-left fa-sm"></i> Back to Queue</a>
          </div>

          <!-- Card 1: selected template setup -->
          <div class="card shadow mb-4">
            <div class="card-header py-3 d-flex justify-content-between align-items-center">
              <h6 class="m-0 font-weight-bold text-primary" data-i18n="qn.card1">Selected Template <small class="text-muted" id="tpl-name"></small></h6>
              <div class="d-flex align-items-center">
                <span class="badge badge-light mr-2" id="draft-badge" style="display:none;"></span>
                <button type="button" class="btn btn-sm btn-outline-primary" id="btn-save-draft" data-i18n="qn.save_draft"><i class="far fa-save"></i> Save Draft</button>
              </div>
            </div>
            <div class="card-body">
              <div class="row">
                <div class="col-lg-4">
                  <h6 class="m-0 font-weight-bold text-primary mb-2" data-i18n="queue.choose_preview">Template Preview <small class="text-muted" data-i18n="queue.choose_auto">(variables shown by name)</small></h6>
                  <div class="text-center bg-light p-2 rounded">
                    <img id="tpl-preview" class="img-fluid label-preview" style="max-height: 220px;" />
                  </div>
                </div>
                <div class="col-lg-8">
                  <div class="form-group">
                    <label data-i18n="qn.variables">Variables</label>
                    <span class="badge badge-info ml-1" id="tpl-layout-badge" style="display:none;"></span>
                    <div id="tpl-variables"><p class="text-muted small mb-0">loading...</p></div>
                  </div>
                  <div class="form-row">
                    <div class="form-group col-md-6">
                      <label for="tpl-printer" data-i18n="qn.printer">Printer <small class="text-muted" data-i18n="qn.printer_auto">(auto-filled from label binding)</small></label>
                      <select class="form-control" id="tpl-printer"></select>
                    </div>
                    <div class="form-group col-md-3">
                      <label for="copies" data-i18n="qn.copies">Copies <small class="text-muted" data-i18n="qn.copies_per">(per task)</small></label>
                      <input type="number" class="form-control" id="copies" value="1" min="1">
                    </div>
                  </div>
                  <div class="alert alert-warning py-2">
                    <i class="fas fa-exclamation-triangle"></i>
                    <span data-i18n="qn.warn">Before printing, please confirm that this printer is the one intended to print this label</span>
                  </div>
                  <button type="button" class="btn btn-primary mr-1" id="btn-single" data-i18n="qn.add_single"><i class="fas fa-plus"></i> Add Single</button>
                  <button type="button" class="btn btn-success" id="btn-batch" data-i18n="qn.batch_add"><i class="fas fa-file-excel"></i> Batch Add</button>

                  <!-- batch add panel -->
                  <div id="batch-panel" class="mt-3 border rounded p-3 bg-light" style="display:none;">
                    <div class="form-group">
                      <button type="button" class="btn btn-sm btn-outline-primary" id="btn-dl-template" data-i18n="qn.dl_template">
                        <i class="fas fa-download"></i> Download xlsx Template (with label variables)
                      </button>
                    </div>
                    <div class="form-group">
                      <label for="batch-file" data-i18n="qn.file">xlsx File <small class="text-muted" data-i18n="qn.file_sub">(header row = variables)</small></label>
                      <input type="file" class="form-control-file" id="batch-file" accept=".xlsx,.xls">
                    </div>
                    <div id="batch-result"></div>
                    <button type="button" class="btn btn-primary" id="batch-add" disabled data-i18n="qn.add_tasks"><i class="fas fa-plus"></i> Add Tasks</button>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <!-- Card 2: staged print tasks -->
          <div class="card shadow mb-4">
            <div class="card-header py-3 d-flex flex-row align-items-center justify-content-between">
              <h6 class="m-0 font-weight-bold text-primary" data-i18n="qn.card2">Print Tasks <span class="badge badge-primary" id="task-count">0</span></h6>
              <div>
                <div class="btn-group btn-group-sm mr-2" role="group">
                  <button type="button" class="btn btn-outline-primary active" id="view-list" data-i18n="qn.list"><i class="fas fa-list"></i> List</button>
                  <button type="button" class="btn btn-outline-primary" id="view-cards" data-i18n="qn.cards"><i class="fas fa-images"></i> Preview Cards</button>
                </div>
                <button type="button" class="btn btn-sm btn-outline-danger mr-2" id="btn-clear" data-i18n="btn.clear"><i class="fas fa-trash"></i> Clear</button>
                <button type="button" class="btn btn-sm btn-primary" id="btn-enqueue" disabled data-i18n="qn.enqueue_all"><i class="fas fa-paper-plane"></i> Enqueue All to Print Queue</button>
              </div>
            </div>
            <div class="card-body">
              <div id="task-list-wrap">
                <!-- selection toolbar: pick tasks by checkbox or by number range, then print only the selected ones -->
                <div class="d-flex align-items-center flex-wrap mb-2">
                  <label class="mb-0 mr-3"><input type="checkbox" id="task-sel-all"> <small data-i18n="qn.select_all">Select all</small></label>
                  <small class="mr-1" data-i18n="qn.from">From No.</small>
                  <input type="number" id="sel-from" class="form-control form-control-sm mr-2" style="width: 72px;" min="1">
                  <small class="mr-1" data-i18n="qn.to">To No.</small>
                  <input type="number" id="sel-to" class="form-control form-control-sm mr-2" style="width: 72px;" min="1">
                  <button type="button" class="btn btn-sm btn-outline-primary mr-2" id="btn-sel-range" data-i18n="qn.select_range"><i class="fas fa-check-double"></i> Select Range</button>
                  <button type="button" class="btn btn-sm btn-success" id="btn-enqueue-selected" disabled data-i18n="qn.print_selected"><i class="fas fa-paper-plane"></i> Print Selected</button>
                </div>
                <table class="table table-bordered table-hover table-sm">
                  <thead>
                    <tr>
                      <th style="width: 36px;" data-i18n="th.sel">Sel</th>
                      <th style="width: 60px;" data-i18n="th.no">No.</th>
                      <th data-i18n="th.variables">Variables</th>
                      <th data-i18n="th.source">Source</th>
                      <th style="width: 80px;" data-i18n="th.action">Action</th>
                    </tr>
                  </thead>
                  <tbody id="task-list"></tbody>
                </table>
              </div>
              <div id="task-cards-wrap" class="row" style="display:none;"></div>
              <p id="task-empty" class="text-muted text-center mb-0" data-i18n="qn.empty">no tasks yet - use Add Single or Batch Add above</p>
            </div>
          </div>

        </div>
        <!-- /.container-fluid -->

      </div>
      <!-- End of Main Content -->

    </div>
    <!-- End of Content Wrapper -->

  </div>
  <!-- End of Page Wrapper -->

  <!-- Modal: single add with live preview -->
  <div class="modal fade" id="singleModal" tabindex="-1" role="dialog" aria-labelledby="singleModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg" role="document">
      <div class="modal-content">
        <div class="modal-header">
          <h5 class="modal-title" id="singleModalLabel" data-i18n="qn.single_title">Single Add <small class="text-muted" id="single-tpl-name"></small></h5>
          <button type="button" class="close" data-dismiss="modal" aria-label="Close">
            <span aria-hidden="true">&times;</span>
          </button>
        </div>
        <div class="modal-body">
          <div class="row">
            <div class="col-md-6">
              <div id="single-variables"></div>
            </div>
            <div class="col-md-6">
              <h6 class="m-0 font-weight-bold text-primary mb-2" data-i18n="qn.live_preview">Live Preview</h6>
              <div class="text-center bg-light p-2 rounded">
                <img id="single-preview" class="img-fluid label-preview" style="max-height: 240px;" />
              </div>
            </div>
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" data-dismiss="modal" data-i18n="btn.cancel">Cancel</button>
          <button type="button" class="btn btn-primary" id="single-add-confirm" data-i18n="qn.add_to_tasks"><i class="fas fa-plus"></i> Add to Tasks</button>
        </div>
      </div>
    </div>
  </div>

  <!-- Scroll to Top Button-->
  <a class="scroll-to-top rounded" href="#page-top">
    <i class="fas fa-angle-up"></i>
  </a>

  <!-- Bootstrap core JavaScript-->
  <script src="/vendor/jquery/jquery.min.js"></script>
  <script src="/vendor/bootstrap/js/bootstrap.bundle.min.js"></script>

  <!-- Core plugin JavaScript-->
  <script src="/vendor/jquery-easing/jquery.easing.min.js"></script>

  <script src="/vendor/toastr/toastr.min.js"></script>

  <!-- Custom scripts for all pages-->
  <script src="/js/sb-admin-2.min.js"></script>
  <script src="/js/main.js"></script>
  <script src="/js/websocket.js"></script>

  <!-- i18n: loads before page scripts so t() is available everywhere -->
  <script src="/js/i18n.js"></script>
  <script src="/js/locales/en.js"></script>
  <script src="/js/locales/zh.js"></script>
  <script src="/js/locales/ar.js"></script>

  <script>
    if (window.module) module = window.module;
    var config = <%- JSON.stringify(config) %>;
  </script>

  <script src="/js/queue_new.js"></script>

</body>

</html>
